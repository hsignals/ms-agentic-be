# Bootstrap health runs without dependencies; protected operations require every service below.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
DEPLOYMENT_ID=local
DATABASE_URL=
REDIS_URL=
# PEM CA for private TLS Valkey. Certificate verification remains enabled.
REDIS_TLS_CA=
OPENAI_API_KEY=
E2B_API_KEY=
GCS_BUCKET_NAME=
# Generate a high-entropy value: openssl rand -hex 32. Never commit the result.
STAGING_AUTH_TOKEN=
STAGING_ACCOUNT_ID=synthetic-account
STAGING_CHANNEL_ID=synthetic-channel
WORKER_CONCURRENCY=1
SANDBOX_TIMEOUT_MS=120000
